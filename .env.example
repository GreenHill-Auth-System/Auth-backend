# GreenHill Central Authentication Backend — environment template
#
# This file is a BLANK FORM. Every value below is empty on purpose — it is
# committed to git, so it can never contain a real secret. `config/settings.py`
# does not store secrets either; it only *reads* them out of the environment.
#
# Do this instead of typing values by hand:
#
#     python generate_env.py
#
# That copies this file to `.env` and fills in SECRET_KEY and
# OIDC_RSA_PRIVATE_KEY automatically. `.env` is git-ignored. NEVER commit it.
#
# On Render, set these in the dashboard instead — `.env` is not deployed.


# ---------------------------------------------------------------------------
# Django core  (required)
# ---------------------------------------------------------------------------

# Required. With no SECRET_KEY every request fails with
# ImproperlyConfigured("The SECRET_KEY setting must not be empty").
# `python generate_env.py` fills this in. To generate one by hand:
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# "True" for local development only. Anything other than "true" is false.
DEBUG=False

# Comma-separated. Add your Render hostname in production.
ALLOWED_HOSTS=127.0.0.1,localhost,138.197.193.101


# ---------------------------------------------------------------------------
# Database  (PostgreSQL)
# ---------------------------------------------------------------------------
# Leave DB_NAME unset to fall back to the local SQLite file `db.sqlite3`.
# Set all of these in production.

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432


# ---------------------------------------------------------------------------
# Google OAuth client  (required for /auth/google/login/)
# ---------------------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback/


# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# No trailing slash. Used for post-login redirects and error pages.

FRONTEND_URL=http://localhost:5173


# ---------------------------------------------------------------------------
# OpenID Connect provider  (required for /o/...)
# ---------------------------------------------------------------------------

# RSA private key used to sign id_tokens. `python generate_env.py` fills this
# in with a fresh 2048-bit key already in the quoted form below.
#
# To do it by hand: openssl genrsa -out oidc.pem 2048   then paste the PEM.
#
# python-dotenv supports multi-line values ONLY when wrapped in double quotes:
#     OIDC_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
#     MIIE...
#     -----END PRIVATE KEY-----"
#
# If your host cannot store multi-line values (Render can), base64-encode the
# PEM instead and decode it in settings.py. The value must be the full PEM with
# real newlines — a single-line value with literal "\n" will not parse.
OIDC_RSA_PRIVATE_KEY=

# Must be the PUBLIC base URL of the provider, ending in /o and no trailing slash.
# Local:      http://127.0.0.1:8000/o
# Production: https://greenhill-auth-backend2.onrender.com/o
OIDC_ISS_ENDPOINT=http://127.0.0.1:8000/o


# ---------------------------------------------------------------------------
# Local OAuth relaxation
# ---------------------------------------------------------------------------
# Set to "development" to allow plain http redirect URIs (OAUTHLIB_INSECURE_TRANSPORT).
# Leave empty in production.

DJANGO_ENV=development


# ---------------------------------------------------------------------------
# Cache  (optional but recommended in production)
# ---------------------------------------------------------------------------
# Leave REDIS_URL unset to use the per-process LocMem cache. LocMem is fine for
# one gunicorn worker; with several workers each process keeps its own cache, so
# throttling and session quick-checks stop being shared. Set REDIS_URL to fix
# that:      REDIS_URL=redis://127.0.0.1:6379/1
# Requires `pip install redis` (already in requirements.txt).

REDIS_URL=


# ---------------------------------------------------------------------------
# Session policy
# ---------------------------------------------------------------------------
# Absolute browser-session lifetime in seconds. Default 8 hours (28800).
SESSION_COOKIE_AGE=28800

# How often the UserSession inventory may be touched for the same session, in
# seconds. Keeps a signed-in tab from writing a row on every request.
SESSION_TOUCH_INTERVAL=60


# ---------------------------------------------------------------------------
# Transport security
# ---------------------------------------------------------------------------
# Redirect every http:// request to https://, and send HSTS.
# BOTH MUST STAY "False" LOCALLY: with SECURE_SSL_REDIRECT=True Django answers
# http://127.0.0.1 with a 301 to https://127.0.0.1, which has no TLS listener,
# and every request fails. Turn them on in production only, after TLS is
# confirmed working on the Render hostname.

SECURE_SSL_REDIRECT=False

# Seconds browsers must remember to use https. 31536000 = 1 year.
# Start at 3600 while testing, raise once verified.
SECURE_HSTS_SECONDS=0


# ---------------------------------------------------------------------------
# Relying parties — the three systems that trust this IdP
# ---------------------------------------------------------------------------
# One block per system. The client id/secret pair is normally generated by
# `python manage.py seed_oauth_clients`, which prints them once. Paste the
# generated values back here so a redeploy keeps the same credentials.
#
# Lists accept comma- or space-separated values.

# --- EID -------------------------------------------------------------------
EID_CLIENT_ID=
EID_CLIENT_SECRET=
EID_REDIRECT_URIS=http://localhost:5173/auth/callback
EID_POST_LOGOUT_REDIRECT_URIS=http://localhost:5173/signed-out
EID_ALLOWED_ORIGINS=http://localhost:5173

# --- Procurement (PMS) -----------------------------------------------------
PROCUREMENT_CLIENT_ID=
PROCUREMENT_CLIENT_SECRET=
PROCUREMENT_REDIRECT_URIS=http://localhost:5174/auth/callback
PROCUREMENT_POST_LOGOUT_REDIRECT_URIS=http://localhost:5174/signed-out
PROCUREMENT_ALLOWED_ORIGINS=http://localhost:5174

# --- Incident Management (ISMP) --------------------------------------------
INCIDENT_CLIENT_ID=
INCIDENT_CLIENT_SECRET=
INCIDENT_REDIRECT_URIS=http://localhost:5175/auth/callback
INCIDENT_POST_LOGOUT_REDIRECT_URIS=http://localhost:5175/signed-out
INCIDENT_ALLOWED_ORIGINS=http://localhost:5175


# ---------------------------------------------------------------------------
# REMOVED — do not set these
# ---------------------------------------------------------------------------
# TEST_USER_PASSWORD
#     Used by migrations 0001-0003 to create/reset a user. Those three
#     migrations are now NO-OPS and no longer read this variable, so setting it
#     does nothing. It is kept here only as a warning: if it is set while an
#     older checkout of this code is deployed, a migrate would have overwritten
#     that account's password. Create accounts with `createsuperuser` instead.
